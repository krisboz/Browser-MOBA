# Server
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://moba:moba@localhost:5432/moba
SNAPSHOT_RATE=20
# How often the game server looks for a newly applied balance version (ms)
BALANCE_POLL_MS=5000

# Owner dashboard (listens on this machine only unless DASHBOARD_TOKEN is set)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8081
DASHBOARD_TOKEN=

# Client (Vite reads VITE_* from apps/client/.env or the environment)
VITE_SERVER_URL=ws://localhost:8080
