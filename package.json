{
  "name": "browser-moba",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @moba/server db:migrate",
    "db:seed": "pnpm --filter @moba/server db:seed",
    "db:publish-seed": "pnpm --filter @moba/server db:publish-seed",
    "dev": "pnpm --parallel --filter @moba/server --filter @moba/client dev",
    "dev:server": "pnpm --filter @moba/server dev",
    "dev:client": "pnpm --filter @moba/client dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
