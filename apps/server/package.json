{
  "name": "@moba/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@moba/balance": "workspace:*",
    "@moba/protocol": "workspace:*",
    "@moba/sim": "workspace:*",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
